# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# Seconds to wait between requests. Raise it for sites with strict rate limits.
SCRAPER_DELAY=1.0

# Default pagination limit when --max-pages is not passed.
SCRAPER_MAX_PAGES=5

# Default CSV destination.
SCRAPER_OUTPUT=output.csv

# Optional outbound proxy, e.g. http://user:pass@proxy-host:8000
SCRAPER_PROXY=
